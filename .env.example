# ============================================================
# AI Content Team — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_ORG_ID=org-...                    # Optional

# --- Pinecone ---
PINECONE_API_KEY=pcsk-...
PINECONE_INDEX_NAME=ai-content-research
PINECONE_ENVIRONMENT=us-east-1-aws       # Your Pinecone region

# --- Neon PostgreSQL ---
# Get this from your Neon dashboard → Connection String
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- AWS S3 (Media Storage) ---
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_S3_BUCKET=ai-content-team-media

# --- CMS Integrations ---
WORDPRESS_URL=https://yourblog.com
WORDPRESS_USERNAME=admin
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx

GHOST_URL=https://yourblog.ghost.io
GHOST_ADMIN_API_KEY=...

# --- Search / Scraping ---
TAVILY_API_KEY=tvly-...
FIRECRAWL_API_KEY=fc-...

# --- App Config ---
NODE_ENV=development
PORT=3001
APP_SECRET=change-this-to-a-random-string-in-production

# --- Token Budget (per project, hard limit) ---
MAX_TOKENS_PER_PROJECT=50000
WARN_TOKENS_THRESHOLD=40000             # Warn user at 80% budget
