{
  "name": "ai-content-team",
  "version": "2.0.0",
  "description": "Autonomous AI Content Creation Team — 28-Node LangGraph System",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "concurrently -k -n backend,frontend -c blue,magenta \"node --watch src/index.js\" \"npm run dev --prefix frontend\"",
    "dev:backend": "node --watch src/index.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "test:connections": "node scripts/testConnections.js"
  },
  "dependencies": {
    "@langchain/community": "^0.3.0",
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/openai": "^0.3.0",
    "@pinecone-database/pinecone": "^3.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.11.5",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
